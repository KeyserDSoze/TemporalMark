# Copy to terraform.tfvars (gitignored). Never commit secrets.
subscription_id          = "00000000-0000-0000-0000-000000000000"
prefix                   = "temporalmark-dev"
location                 = "westeurope"
storage_account_name     = "tmreplacewithunique"
# Default: ACA ENVIRONMENT internal VNet load balancer + web/API app ingress internal.
# True makes both environment and web PUBLIC; review replacement, WAF, log-DPIA and CAB first.
enable_public_web_ingress = false
# FAKE placeholders ONLY: replace with actual registry-reported image manifest digests.
# Keep the API/web release evidence and build-embedded OIDC authority aligned.
api_image                = "registry.example.invalid/temporalmark-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
web_image                = "registry.example.invalid/temporalmark-web@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
oidc_authority           = "https://id.example.com/realms/temporalmark"
postgres_admin           = "temporalmarkadmin"
postgres_password        = "SET_VIA_TF_VAR_postgres_password_INSTEAD"
# FAKE NON-SECRET identifiers. Provision a dedicated RBAC-enabled Key Vault and
# approve/provision the secret VALUE separately, never through this Terraform.
# Reference an exact secret VERSION to make rollouts explicitly reviewable.
registry_connection_secret_uri = "https://tmciregistryvault.vault.azure.net/secrets/registry-connection/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
registry_connection_key_vault_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/tm-ci-kv-rg/providers/Microsoft.KeyVault/vaults/tmciregistryvault"
evidence_retention_days  = 3650
