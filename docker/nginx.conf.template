server {
  listen 80;
  server_name _;
  # Explicitly override the upstream combined format in this server.
  # The only access metadata is status, method and request duration.
  access_log /dev/stdout temporalmark_minimal;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  location /healthz { proxy_pass ${API_UPSTREAM}/healthz; }
  location / { try_files $uri $uri/ /index.html; }
}
