server {
  listen 80;
  server_name _;
  # Explicitly override the upstream combined format in this server.
  # The only access metadata is status, method and request duration.
  access_log /dev/stdout temporalmark_minimal;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # #136 / ADR 0102: limit the sensitive exact imprint-search body
  # BEFORE proxy buffering. The inherited server access_log remains minimal.
  # Nginx would otherwise write a 413 request line (including an attacker
  # controlled imprint/query) to stderr at error severity. Suppress only
  # that location's subcritical error diagnostics; other routes unchanged.
  location ~* ^/api/v1/stamps/search$ {
    client_max_body_size 4k;
    error_log /dev/stderr crit;
    # #143/ADR 0108: pre-auth local per-peer gate. Never key off XFF,
    # JWT, tenant, document digest, URI/query, or request body.
    limit_req zone=tm_search_peer burst=12 nodelay;
    limit_req_status 429;
    error_page 429 = @tm_search_edge_denied;
    # Upstream SQL 429/Retry-After is distinct; do not intercept it.
    proxy_intercept_errors off;
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  # Local-only Nginx rejection; upstream 429 remains untouched.
  # No sensitive request line, raw URL/query, bearer or imprint in body/log.
  location @tm_search_edge_denied {
    internal;
    error_log /dev/stderr crit;
    add_header Cache-Control "no-store" always;
    add_header Retry-After "1" always;
    return 429;
  }
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  location /healthz { proxy_pass ${API_UPSTREAM}/healthz; }
  location / { try_files $uri $uri/ /index.html; }
}
