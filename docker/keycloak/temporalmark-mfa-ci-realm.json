{
  "realm": "temporalmark-mfa-ci",
  "displayName": "TemporalMark DISPOSABLE MFA TEST REALM ONLY",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 180,
  "ssoSessionIdleTimeout": 300,
  "ssoSessionMaxLifespan": 900,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "attributes": {
    "acr.loa.map": "{\"urn:temporalmark:loa:2\":\"2\"}"
  },
  "roles": {
    "realm": [
      {
        "name": "platform_approver",
        "description": "Disposable MFA CI approver, not a production account"
      },
      {
        "name": "platform_credential_registrar",
        "description": "Disposable registrar MFA CI ONLY, no production authority, SQL permissions or trusted credential"
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "temporalmark-ci-password-otp",
      "description": "Disposable CI step-up: no cookie shortcut, require conditional LoA 1 and 2",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "temporalmark-ci-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "temporalmark-ci-forms",
      "description": "Ordered conditional LoA requirements: password then OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "temporalmark-ci-level-1",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "temporalmark-ci-level-2",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "temporalmark-ci-level-1",
      "description": "Password authentication counts as LoA 1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "temporalmark-ci-loa1-config"
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "temporalmark-ci-level-2",
      "description": "Real OTP verification counts as LoA 2 only on this request",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "temporalmark-ci-loa2-config"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "browserFlow": "temporalmark-ci-password-otp",
  "clients": [
    {
      "clientId": "temporalmark-mfa-pkce-ci",
      "name": "Disposable OTP authorization-code PKCE client - NEVER PROD",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:45678/oidc-mfa-callback",
        "http://127.0.0.1:46678/oidc-mfa-callback",
        "http://127.0.0.1:47678/oidc-mfa-callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "minimum.acr.value": "urn:temporalmark:loa:2"
      },
      "protocolMappers": [
        {
          "name": "mfa-ci-approval-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "temporalmark-approval",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mfa-ci-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mfa-ci-acr-real-level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "mfa-ci-identity-introspection-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "temporalmark-mfa-identity-introspector",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "temporalmark-approval",
      "name": "Approval token audience only",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "temporalmark-registrar-pkce-ci",
      "name": "Disposable registrar OTP + Authorization Code S256 PKCE, NEVER PROD",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:45679/registrar-mfa-callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "minimum.acr.value": "urn:temporalmark:loa:2"
      },
      "protocolMappers": [
        {
          "name": "mfa-ci-registrar-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "temporalmark-credential-registrar",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mfa-ci-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mfa-ci-acr-real-level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "mfa-ci-identity-introspection-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "temporalmark-mfa-identity-introspector",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "temporalmark-credential-registrar",
      "name": "Registrar access token audience only - no login",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "temporalmark-mfa-identity-introspector",
      "name": "Disposable MFA token introspection only",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-mfa-introspect-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "temporalmark-mfa-directory-checker",
      "name": "Disposable MFA current-user/realm-role directory readonly client",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-mfa-directory-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000034",
      "username": "demo-mfa-approver",
      "firstName": "Disposable",
      "lastName": "OTP",
      "email": "disposable-otp@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "platform_approver"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "disposable-mfa-password-only",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000035",
      "username": "demo-mfa-registrar",
      "firstName": "Disposable",
      "lastName": "Registrar OTP",
      "email": "registrar-otp@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "platform_credential_registrar"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "disposable-registrar-otp-password",
          "temporary": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "temporalmark-ci-loa1-config",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "temporalmark-ci-loa2-config",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    }
  ]
}
